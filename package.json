{
  "name": "protons-hn",
  "version": "0.3.0",
  "description": "A tasteful, fast modern layer over Hacker News. Faithful to the original, just modern.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
